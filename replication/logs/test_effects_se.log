>                      "`un' `pn'", "V8")
 23.     if ("`c'" == "kx") {
 24.         qui gen double IF_slope = .
 25.         local cn : colfullnames e(b)
 26.         local j1 : list posof "y_1:lambda_x" in cn
 27.         local j0 : list posof "y_0:lambda_x" in cn
 28.         mata: _t8_slope(`j1', `j0')
 29.         local stats "`stats' slope"
 30.     }
 31.     foreach s in att atu ate kap m km dh2 dh3 {
 32.         cap confirm variable U_`s'
 33.         if (_rc == 0) qui gen double IF_`s' = U_`s' + P_`s'
 34.     }
 35.     local bf : dir "tests/bruteforce/out" files "bf2_`c'_*.dta"
 36.     foreach f of local bf {
 37.         qui merge 1:1 id using "tests/bruteforce/out/`f'", nogen update
 38.     }
 39.     local tol = cond(inlist("`c'", "fiml", "het"), 5e-3, 1e-3)
 40.     foreach s of local stats {
 41.         tempvar g a
 42.         qui gen double `g' = abs(B_`s' - IF_`s') if B_`s' < .
 43.         qui gen double `a' = abs(IF_`s') if B_`s' < .
 44.         qui summarize `g', meanonly
 45.         local gmax = r(max)
 46.         qui summarize `a', meanonly
 47.         local rel = `gmax' / r(max)
 48.         qui regress B_`s' IF_`s', noconstant
 49.         _chk "brute force `c': slope of BF on IF(`s') = 1" _b[IF_`s'] 1 `=`tol'/10'
 50.         _chk "brute force `c': max|BF - IF(`s')| / max|IF|" `rel' 0 `tol'
 51.     }
 52. }
