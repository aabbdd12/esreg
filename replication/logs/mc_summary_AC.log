. * identities of the routes by regime, replication by replication: ATT depends on
. * the untreated regime's Hermite terms only, ATU on the treated regime's
. foreach route of local routes {
  2.     if ("`route'" == "r1") local pairs "r1_att ln_att r1_atu h3_atu"
  3.     if ("`route'" == "r0") local pairs "r0_att h3_att r0_atu ln_atu"
  4.     if (!inlist("`route'", "r1", "r0")) continue
  5.     while ("`pairs'" != "") {
  6.         gettoken a pairs : pairs
  7.         gettoken b pairs : pairs
  8.         foreach v in "" "se_" {
  9.             tempvar g
 10.             qui gen double `g' = abs(`v'`a' - `v'`b')
 11.             qui summarize `g', meanonly
 12.             di as txt "identity `v'`a' = `v'`b': largest |difference| over the replications " as res %9.2e r(max)
 13.         }
 14.     }
 15. }

. 
end of do-file
