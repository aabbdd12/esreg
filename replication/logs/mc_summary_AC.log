. local i = 0

. foreach s of local stats {
  2.     local ++i
  3.     local k = substr("`s'", strpos("`s'", "_") + 1, .)
  4.     if ("`s'" == "kdd") local k "kdd"
  5.     local tv = `t_`k''
  6.     qui count if `s' < . & se_`s' < .
  7.     local nv = r(N)
  8.     qui summarize `s' if se_`s' < .
  9.     local mn = r(mean)
 10.     local sd = r(sd)
 11.     tempvar q c
 12.     qui gen double `q' = se_`s'^2 if `s' < .
 13.     qui summarize `q', meanonly
 14.     local rms = sqrt(r(mean))
 15.     qui summarize se_`s' if `s' < ., meanonly
 16.     local mse = r(mean)
 17.     qui gen byte `c' = abs(`s' - `tv') <= invnormal(.975)*se_`s' if `s' < . & se_`s' < .
 18.     qui summarize `c', meanonly
 19.     local cov = r(mean)
 20.     di as txt %10s "`s'" " {c |}" as res %9.4f `tv' %10.4f `mn' %10.4f `mn' - `tv' %10.4f `sd' %10.4f `rms' ///
>        %10.4f `mse' %10.4f `rms'/`sd' %12.4f `cov' %8.0f `nv' %10.4f sqrt((`mn' - `tv')^2 + `sd'^2)
 21.     mat `S'[`i', 1] = `tv'
 22.     mat `S'[`i', 2] = `mn'
 23.     mat `S'[`i', 3] = `sd'
 24.     mat `S'[`i', 4] = `rms'
 25.     mat `S'[`i', 5] = `mse'
 26.     mat `S'[`i', 6] = `rms'/`sd'
 27.     mat `S'[`i', 7] = `cov'
 28.     mat `S'[`i', 8] = `nv'
 29.     mat `S'[`i', 9] = `R'
 30.     mat `S'[`i', 10] = sqrt((`mn' - `tv')^2 + `sd'^2)
 31. }
