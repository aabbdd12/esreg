. do "tests/esrdiag_test.do"

. * esrdiag_test.do -- diagnostics of the selection equation (Section 4.4) against the
. * Python reference (esreg/diag.py).  Run from the project root:
. *   tools\run_stata.bat tests\esrdiag_test.do
. version 16

. clear all

. set more off

. foreach f in esreg esreg_lf1 esreg_engine esreg_mata _esreg_getest _esreg_data _esreg_effects_post _esreg_esample _esr
> eg_ifcov esreg_p esrdiag {
  2.     cap confirm file "`f'.ado"
  3.     if (_rc == 0) run "`f'.ado"
  4.     else {
  5.         cap confirm file "src/`f'.ado"
  6.         if (_rc == 0) run "src/`f'.ado"
  7.         else          run "../src/`f'.ado"
  8.     }
  9. }

. 
