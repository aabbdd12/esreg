  log type:  text
 opened on:   3 Oct 2026, 08:38:40

. do "tests/esreg_wt_test.do"

. * esreg_wt_test.do -- weights: pweights, svyset auto-detection, hsize(), the svy prefix,
. * predict scores; against the Python references of export_wt.py (data/esr_wt.dta)
. foreach f in esreg esreg_lf1 esreg_engine esreg_mata _esreg_getest _esreg_data _esreg_effects_post _esreg_esample _esr
> eg_ifcov esreg_p esrdiag esrtest {
  2.     cap confirm file "`f'.ado"
  3.     if (_rc == 0) run "`f'.ado"
  4.     else {
  5.         cap confirm file "src/`f'.ado"
  6.         if (_rc == 0) run "src/`f'.ado"
  7.         else          run "../src/`f'.ado"
  8.     }
  9. }

. use "data/esr_wt.dta", clear
(esr_annex2 with sampling weight wt and household size hsize (seed 2026))

